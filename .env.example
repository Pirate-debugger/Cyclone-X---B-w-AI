# CYCLONE-X V3 Enterprise Environment Configuration
# Google-Native AI + Probabilistic Weather + Disaster Impact Intelligence
APP_MODE=demo
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Cloud Project & Regional Settings
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Google Gemini AI (Vertex AI or Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Vertex AI Predictive Impact Model
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1
VERTEX_IMPACT_ENDPOINT=

# Google Earth Engine
EARTH_ENGINE_PROJECT=

# Google Maps Platform
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_WEATHER_API_ENABLED=false
GOOGLE_ROUTES_API_KEY=

# Firebase Authentication & Firestore
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# BigQuery Analytics & Archival
BIGQUERY_PROJECT=
BIGQUERY_DATASET=cyclonex_analytics

# Google Cloud Storage & Pub/Sub
GCS_BUCKET=
PUBSUB_PROJECT=

# Database & Cache (Cloud SQL PostgreSQL+PostGIS in production, SQLite in local demo)
DATABASE_URL=sqlite:///./cyclonex.db
REDIS_URL=redis://localhost:6379/0

# Operational Meteorological Feeds
IMD_ENABLED=true
INCOIS_ENABLED=false
BHUVAN_ENABLED=false
WEATHERNEXT3_ENABLED=false
WEATHERNEXT_CYCLONES_ENABLED=true

# Speech & Translation Services
SPEECH_ENABLED=false
TRANSLATION_ENABLED=false

# RBAC Admin Secret (Optional override)
CYCLONEX_ADMIN_API_KEY=
