# CYCLONE-X Environment Configuration Template
# Copy to .env and configure as needed.
# By default, CYCLONE-X runs in DEMO MODE with zero external credentials required.

# Application Mode: 'demo' (offline with simulated data) or 'live' (real API queries)
APP_MODE=demo
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database Configuration (PostGIS for production Docker deployment)
DATABASE_URL=postgresql://cyclonex:cyclonex_secret@db:5432/cyclonex_db

# Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Google Earth Engine Configuration
# Required only for LIVE Earth Engine tile generation and on-the-fly SAR reducers
GOOGLE_CLOUD_PROJECT=
EARTH_ENGINE_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Weather Service Configuration
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Map Base Layer Configuration (CartoDB Dark requires no API key)
MAP_PROVIDER=carto-dark
MAP_API_KEY=

# Notification & Storage
NOTIFICATION_PROVIDER=dry_run
NOTIFICATION_API_KEY=
STORAGE_PROVIDER=filesystem
