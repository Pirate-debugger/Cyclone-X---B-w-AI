# CYCLONE-X V2 Environment Configuration Template
# Copy to .env and configure as needed.
# By default, CYCLONE-X runs in DEMO MODE with zero external credentials required.

# Application Mode: 'demo' (offline with simulated data) or 'live' (real API queries)
APP_MODE=demo
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database & Cache (PostgreSQL + PostGIS for production; SQLite for local dev)
DATABASE_URL=postgresql://cyclonex:cyclonex_secret@db:5432/cyclonex_db
REDIS_URL=redis://localhost:6379/0

# Google Gemini AI Configuration (Get key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Google Earth Engine Configuration (Required for LIVE Earth Engine tile generation)
GOOGLE_CLOUD_PROJECT=
EARTH_ENGINE_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# WeatherNext 3 Enterprise NWP Configuration
WEATHERNEXT3_ENABLED=false
WEATHERNEXT3_ACCESS_MODE=demo
WEATHERNEXT3_PROJECT=
WEATHERNEXT3_DATASET=weathernext_3_operational
WEATHERNEXT_GCS_BUCKET=

# WeatherNext Cyclones Dedicated Model
CYCLONE_MODEL_PROVIDER=weathernext_cyclones
CYCLONE_MODEL_CHECKPOINT=weathernext_cyclones_v1_weights.pt
CYCLONE_MODEL_MODE=demo

# Baseline Meteorological & Oceanographic Services
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
ECMWF_ENABLED=true
IBTRACS_ENABLED=true
INCOIS_ENABLED=false

# Basemap, Notification & Object Storage
MAP_PROVIDER=carto-dark
MAP_API_KEY=cb1_3zqt_1_dc5d1212b00788ce3409d182
NEXT_PUBLIC_CARTO_API_KEY=cb1_3zqt_1_dc5d1212b00788ce3409d182
NEXT_PUBLIC_MAP_KEY=cb1_3zqt_1_dc5d1212b00788ce3409d182
NOTIFICATION_PROVIDER=dry_run
NOTIFICATION_API_KEY=
STORAGE_PROVIDER=filesystem
